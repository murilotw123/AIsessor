# --- Telegram ---
# Token do bot (BotFather)
TELEGRAM_BOT_TOKEN=
# Seu ID numérico do Telegram (@userinfobot). Só você poderá usar o bot.
TELEGRAM_USER_ID=

# --- IA local (Ollama) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# --- Transcrição de áudio (faster-whisper, local) ---
# Opções: tiny, base, small, medium (maior = mais preciso e mais lento)
WHISPER_MODEL=small

# --- Agenda ---
# Qual agenda usar: google, apple ou google,apple
AGENDA=google

# --- Geral ---
TIMEZONE=America/Sao_Paulo
